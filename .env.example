# مفاتيح التحليل الأساسية
OPENAI_API_KEY=
TWELVE_DATA_API_KEY=

# بريد Gmail لإرسال ملاحظات التطبيق
# لا تستخدم كلمة مرور Gmail العادية؛ استخدم Google App Password.
SALEEM_EMAIL=your-email@gmail.com
RESEND_API_KEY=re_xxxxxxxxx

# اختياري كخيار SMTP احتياطي
# SALEEM_EMAIL_APP_PASSWORD=abcdefghijklmnop

# اختياري: اتركه فارغًا لإرسال الملاحظات إلى SALEEM_EMAIL نفسه
APP_OWNER_EMAIL=

# إعدادات متقدمة اختيارية؛ Gmail يعمل دون إضافتها
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_FROM=your-email@gmail.com

# لوحة حالة التطبيق الخاصة بالمالك
# اختر رقمًا سريًا لا يعرفه المستخدمون.
# استخدم /data عند إضافة Railway Volume حتى لا تضيع الإحصاءات بعد إعادة التشغيل.
SALEEM_SYSTEM_STATUS_PATH=/data/saleem_system_status.json
SALEEM_FEEDBACK_STORE_PATH=/data/saleem_feedback_store.json
MARKET_DATA_CACHE_PATH=/data/saleem_market_data_cache.json
ANALYSIS_SNAPSHOT_CACHE_PATH=/data/saleem_analysis_snapshot_cache.json

# قيمة الرصيد الذي تريد أن يحسب SaleeM المتبقي منه بالدولار.
OPENAI_CREDIT_USD=
# اختياري: Admin API Key لقراءة التكلفة الرسمية من OpenAI.
# المفتاح العادي OPENAI_API_KEY لا يكفي لواجهة تكاليف المؤسسة.
OPENAI_ADMIN_KEY=

# حدود خطة Twelve Data Basic؛ يمكن تغييرها عند ترقية الخطة.
TWELVE_DATA_PLAN=Basic
TWELVE_DATA_MINUTE_LIMIT=8
TWELVE_DATA_DAILY_LIMIT=800

# أسعار تقريب تكلفة آخر تحليل عند عدم إضافة OPENAI_ADMIN_KEY.
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_CACHED_USD_PER_MILLION=0.10
OPENAI_OUTPUT_USD_PER_MILLION=1.60

# حجم نقطة السكالب في الذهب. الافتراضي: 0.10 دولار للنقطة.
# 5 نقاط = 0.50 دولار، و10 نقاط = 1.00 دولار.
SALEEM_SCALP_POINT_SIZE=0.10

# توازن بين اكتمال القرار وسرعة الاستجابة
OPENAI_MAX_OUTPUT_TOKENS=3900

# V8.0 — بوابة M5 الحية النهائية
# يجلب SaleeM طلب M5 إضافيًا واحدًا قبل إخراج النتيجة للتأكد أن القرار لم يصبح قديمًا.
# لا توجد مراقبة سوق في الخلفية ولا استهلاك دوري للاعتمادات.
SALEEM_FINAL_M5_REFRESH=1
